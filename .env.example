# ===== إعدادات البيئة — انسخ هذا الملف إلى .env وعدّل القيم =====

# قاعدة البيانات: التطوير SQLite، والإنتاج PostgreSQL
DATABASE_URL=sqlite:///./erp.db
# DATABASE_URL=postgresql+psycopg2://erp_user:StrongPass@localhost:5432/erp_db

# تجميعة اتصالات PostgreSQL (تُستخدم فقط مع postgresql://)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# أسرار المصادقة — غيّرها إلزاميًا في الإنتاج (openssl rand -hex 32)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# كلمة مرور المدير عند أول تشغيل فقط (إن تُترك فارغة تُولَّد عشوائيًا وتُطبع في اللوج)
ADMIN_INITIAL_PASSWORD=

# origins المسموح بها لواجهة Frontend مفصولة بفواصل
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:3000
